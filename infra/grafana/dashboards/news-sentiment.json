    {
      "id": 5,
      "title": "POST requests per minute",
      "type": "timeseries",
      "description": "Five-minute smoothed rate, expressed as requests/minute. Requires at least two scrapes.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "news-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(news_requests_total{job=\"news-sentiment\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "news-prometheus"
          },
          "legendFormat": "Requests / min",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
