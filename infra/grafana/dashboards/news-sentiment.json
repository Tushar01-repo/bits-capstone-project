    {
      "id": 7,
      "title": "Mean POST latency \u00b7 5 minute window",
      "type": "timeseries",
      "description": "Mean only; the app does not export latency histograms. No value during an idle window. Evaluation/drift are included.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "news-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(news_request_duration_seconds_sum{job=\"news-sentiment\"}[5m])) / sum(rate(news_request_duration_seconds_count{job=\"news-sentiment\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "news-prometheus"
          },
          "legendFormat": "Mean latency",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "Idle / no samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
