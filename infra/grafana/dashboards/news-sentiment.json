      "title": "Failed POST percentage \u00b7 5 minute window",
      "type": "timeseries",
      "description": "Error percentage across all POST requests. No value when the denominator is zero.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "news-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(news_errors_total{job=\"news-sentiment\"}[5m])) / sum(rate(news_requests_total{job=\"news-sentiment\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "news-prometheus"
